 ],
 "lines": [
  {
   "i": 0,
   "text": "What if Iceland tried to take over the world? Realistically.",
   "s": 0.0,
   "e": 3.82
  },
  {
   "i": 1,
   "text": "Iceland has 390,000 people, and no army. None.",
   "s": 4.82,
   "e": 8.88
  },
  {
   "i": 2,
   "text": "Its whole military is a coast guard: about 200 people, two patrol ships, one plane, and a few helicopters.",
   "s": 9.44,
   "e": 15.94
  },
  {
   "i": 3,
   "text": "So the first target is the closest: the Faroe Islands, about 450 kilometers away.",
   "s": 16.64,
   "e": 22.24
  },
  {
   "i": 4,
   "text": "The fleet sails overnight. The Faroes have no army either, and Iceland plants its flag in Tórshavn.",
   "s": 22.74,
   "e": 29.2
  },
