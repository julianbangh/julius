{
  "name": "stockshark",
  "version": "1.0.0",
  "private": true,
  "description": "Stockshark Bot: a chess board where full-strength Stockfish calculates and Claude plans, connected over MCP.",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "stockshark": "server/index.mjs"
  },
  "scripts": {
